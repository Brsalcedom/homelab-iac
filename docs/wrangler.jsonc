// Static-assets-only Worker: no script, no failover logic.
// Deployed by .github/workflows/docs.yaml after `astro build`.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "homelab-docs",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [
    { "pattern": "docs.cervant.net", "custom_domain": true }
  ],
  "workers_dev": false
}
